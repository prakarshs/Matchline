# LOCAL (do not expose directly on a public IP): default runs one shared DEMO book.
MATCHLINE_HTTP_HOST=127.0.0.1
MATCHLINE_HTTP_PORT=8080
MATCHLINE_QUEUE_CAPACITY=1024
# Optional: managed hosts such as Render supply PORT; this is used if
# MATCHLINE_HTTP_PORT is unset. Container defaults to HTTP_PORT=8080.

# PUBLIC DEMO: enable strictly bounded per-browser ephemeral sessions.
# Set true only with a real reverse proxy / TLS when serving publicly.
# MATCHLINE_PUBLIC_DEMO=true
# MATCHLINE_HTTP_HOST=0.0.0.0
# The exact public portfolio origin (not an URL path, no trailing slash):
# MATCHLINE_EMBED_ORIGIN=https://your-portfolio.pages.dev

# LOCAL JOURNAL MODE, mutually exclusive with MATCHLINE_PUBLIC_DEMO=true:
# mkdir -p local-data; persist this directory if running inside a container.
# MATCHLINE_JOURNAL_PATH=local-data/demo.mlj
# MATCHLINE_SNAPSHOT_PATH=local-data/demo.mls
# MATCHLINE_DURABILITY=SYNC_EACH_RECORD

# LOCAL ONLY. Never enable public reset or combine it with public demo:
# MATCHLINE_RESET_TOKEN=replace-with-at-least-32-random-characters
# Cross-origin API access is OFF by default and forbidden in public-demo mode:
# MATCHLINE_ALLOWED_ORIGIN=https://a-trusted-local-tool.example

# Optional settings for `./gradlew run --args='--serve'`.
# .env is ignored; this file is a reference. Export variables in WSL or use
# `set -a; source .env; set +a` only with a trusted, shell-safe .env.
MATCHLINE_HTTP_HOST=127.0.0.1
MATCHLINE_HTTP_PORT=8080
MATCHLINE_QUEUE_CAPACITY=1024
# MATCHLINE_ALLOWED_ORIGIN=https://your-own-portfolio-origin.example
# MATCHLINE_EMBED_ORIGIN=https://your-portfolio.example  # permits ONLY /preview framing
# MATCHLINE_RESET_TOKEN=replace-with-at-least-32-random-characters
# mkdir -p local-data before enabling persistence:
# MATCHLINE_JOURNAL_PATH=local-data/demo.mlj
# MATCHLINE_SNAPSHOT_PATH=local-data/demo.mls
# MATCHLINE_DURABILITY=SYNC_EACH_RECORD
# Public binding without a gateway/authentication layer is NOT recommended.
